FROM node:20-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ARG VITE_API_URL=/api
ARG VITE_API_LOGIN=http://localhost:7070
ARG VITE_AUTH_BASE_URL=
ARG VITE_PUBLIC_BASE_URL=http://localhost:30080
ARG VITE_OAUTH_RESPONSE_TYPE=code
ARG VITE_OAUTH_CLIENT_ID=7fcdbb6c-fc1d-4921-a52d-0466557b6132
ARG VITE_OAUTH_CLIENT_SECRET=f584278e-be8a-4f55-9c64-8e7be8f9e846
ARG VITE_OAUTH_SCOPE=openid
ARG VITE_OAUTH_REDIRECT_URI=http://localhost:30080/login/oauth2/code/volunteerhub
ARG VITE_GG_CLIENT_ID=485996629423-td2c31e9vppq688o0ucdjtfgb89i6lt1.apps.googleusercontent.com
ARG VITE_GG_CLIENT_SECRET=
ARG VITE_GOOGLE_REDIRECT_URI=http://localhost:30080/login/oauth2/code/google

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_API_LOGIN=$VITE_API_LOGIN
ENV VITE_AUTH_BASE_URL=$VITE_AUTH_BASE_URL
ENV VITE_PUBLIC_BASE_URL=$VITE_PUBLIC_BASE_URL
ENV VITE_OAUTH_RESPONSE_TYPE=$VITE_OAUTH_RESPONSE_TYPE
ENV VITE_OAUTH_CLIENT_ID=$VITE_OAUTH_CLIENT_ID
ENV VITE_OAUTH_CLIENT_SECRET=$VITE_OAUTH_CLIENT_SECRET
ENV VITE_OAUTH_SCOPE=$VITE_OAUTH_SCOPE
ENV VITE_OAUTH_REDIRECT_URI=$VITE_OAUTH_REDIRECT_URI
ENV VITE_GG_CLIENT_ID=$VITE_GG_CLIENT_ID
ENV VITE_GG_CLIENT_SECRET=$VITE_GG_CLIENT_SECRET
ENV VITE_GOOGLE_REDIRECT_URI=$VITE_GOOGLE_REDIRECT_URI

RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80
