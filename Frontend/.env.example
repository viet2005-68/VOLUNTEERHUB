# API config
# Use /api when frontend is served by nginx/k8s and nginx proxies /api to ApiGateway.
# Use http://localhost:8080/api when running Vite dev server directly.
VITE_API_URL=/api
VITE_API_LOGIN=http://localhost:7070

# VolunteerHub OAuth config
VITE_OAUTH_RESPONSE_TYPE=code
VITE_OAUTH_CLIENT_ID=your-volunteerhub-client-id
VITE_OAUTH_CLIENT_SECRET=your-volunteerhub-client-secret
VITE_OAUTH_SCOPE=openid
VITE_OAUTH_REDIRECT_URI=http://localhost:30080/login/oauth2/code/volunteerhub

# Google OAuth config
VITE_GG_CLIENT_ID=your-google-client-id
VITE_GG_CLIENT_SECRET=your-google-client-secret
VITE_GOOGLE_REDIRECT_URI=http://localhost:30080/login/oauth2/code/google

# Optional custom auth header/value used by the current frontend flow.
VITE_CUSTOM_AUTH=your-volunteerhub-client-id:your-volunteerhub-client-secret

# Chat WebSocket config
VITE_CHAT_WS_URL=ws://localhost:8086/ws/chat
